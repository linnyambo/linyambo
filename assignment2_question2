import sqlite3

conn = sqlite3.connect("school.db")      # 1. open (or create) the database
cur = conn.cursor()                      # 2. create a cursor

try:
    cur.execute("""
        CREATE TABLE IF NOT EXISTS students (
            id    INTEGER PRIMARY KEY AUTOINCREMENT,
            name  TEXT NOT NULL,
            grade INTEGER
        )
    """)

    # 3. insert data using ? placeholders (safe from SQL injection)
    cur.execute("INSERT INTO students (name, subject) VALUES (?, ?)",
                ("Trish jones", Accounts))
    cur.executemany("INSERT INTO students (name, grade) VALUES (?, ?)",
                    [("Brielle Tanaka", Biology), ("Belinda Tariro", Chemistry)])

    conn.commit()                        # 4. make the changes permanent

    # 5. query the data
    cur.execute("SELECT id, name, grade FROM students WHERE grade >= ?", (5,))
    for row in cur.fetchall():
        print(row)

except sqlite3.Error as err:
    conn.rollback()                      # undo the transaction on failure
    print("Database error:", err)

finally:
    conn.close()                         # 6. always release the connection
#The SQLite database engine is built into Python through the sqlite3 module. To interact with a SQLite database, three important steps are commonly involved:
1.	Connecting to the database using sqlite3.connect()
2.	Creating and using a cursor object
3.	Saving changes with the commit() method
•	sqlite3.connect(): Opens or creates a SQLite database and returns a connection object.
•	Cursor Object (cursor()): Executes SQL commands and retrieves results from the database.
•	commit(): Saves all database changes permanently.
•	close(): Closes the database connection and releases resources.
